# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Keys are only read on the server. Set at least one of ANTHROPIC_API_KEY or GEMINI_API_KEY for live AI;
# with neither, the instant demos still work and visitors can add their own Anthropic key in Settings.

# Claude (paid, pay-as-you-go). Get a key at https://platform.claude.com/ — used first when set.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5).
# claude-sonnet-5-5 costs about half as much; claude-fable-5-1 is the most capable (and most expensive).
# Models without adaptive thinking / effort support (e.g. claude-haiku-4-5) are not supported.
# ANTHROPIC_MODEL=claude-opus-5-5

# Google Gemini (free tier). Get a key at https://aistudio.google.com/ — used when ANTHROPIC_API_KEY is empty.
# Free-tier limits are per Google project, and Google may use free-tier content to improve its products.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: free models to fail over to, in order, when the main one is busy or out of quota
# (default: gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview). Set it to an empty value to disable failover.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview

# Optional: per-stage effort overrides (low | medium | high). Defaults are tuned for latency.
# LUNOR_EFFORT_BUILD=low
# LUNOR_EFFORT_PLAN=low

# Optional: requests allowed per IP per 15 minutes when using a server key (a build counts as 3). Default 45.
# LUNOR_RATE_LIMIT=45

# Local testing without an API key: stream the bundled sample apps through the real API/streaming path.
# (npm run dev:mock sets this for you.)
# LUNOR_MOCK_AI=1
